PORT=5010
MONGO_URI=mongodb://127.0.0.1:27017/huxnStore
JWT_SECRET=replace-with-a-long-random-secret

# Required for new customer email verification. Put real secrets in .env.mail (ignored).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Persistent Web Push keys (generate once; keep private key out of Git).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
